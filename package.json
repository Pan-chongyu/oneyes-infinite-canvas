{
  "name": "oneyes-infinite-canvas",
  "version": "0.20.57",
  "private": true,
  "description": "OneYes 无限画布桌面版，基于 basketikun/infinite-canvas",
  "author": "OneYes / basketikun",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "npm --prefix canvas-agent run build && npm --prefix web run build",
    "test": "node --test test/*.test.mjs && npm --prefix web run test:oneyes",
    "test:chat": "node scripts/test-agent-chat.mjs",
    "test:ota-ui": "node scripts/test-agent-chat.mjs --updates",
    "test:images": "node scripts/test-agent-chat.mjs --images",
    "test:codec": "node scripts/test-image-codec.mjs",
    "release:delta": "node scripts/prepare-ota-base.mjs release-base",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "pretest": "npm --prefix canvas-agent run build",
    "test:webdav": "node scripts/test-agent-chat.mjs --webdav",
    "test:plugins": "node scripts/test-agent-chat.mjs --plugins",
    "test:videos": "node scripts/test-agent-chat.mjs --videos"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.oneyes.canvas",
    "productName": "OneYes Canvas",
    "artifactName": "OneYes-Canvas-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "desktop-dist",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/**/*.cjs",
      "desktop/**/*.ps1",
      "desktop/**/*.sh",
      "node_modules/bsdiff-wasm/**/*",
      "canvas-proxy/transport.js",
      "canvas-proxy/package.json",
      "web/dist/**/*",
      "LICENSE",
      "NOTICE.md",
      "desktop/resources/CODEX-LICENSE.txt"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "desktop/resources/icon.ico",
      "artifactName": "OneYes-Canvas-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OneYes Canvas",
      "runAfterFinish": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "desktop/resources/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "OneYes-Canvas-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "desktop/resources/icon.png",
      "category": "Graphics",
      "maintainer": "OneYes",
      "executableName": "oneyes-canvas",
      "desktop": {
        "entry": {
          "StartupWMClass": "oneyes-canvas"
        }
      },
      "artifactName": "OneYes-Canvas-${version}-Linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Pan-chongyu",
      "repo": "oneyes-infinite-canvas"
    },
    "extraResources": [
      {
        "from": "canvas-agent",
        "to": "canvas-agent",
        "filter": [
          "dist/**/*",
          "package.json",
          "agent-instructions.md"
        ]
      },
      {
        "from": "canvas-agent/node_modules",
        "to": "canvas-agent/node_modules",
        "filter": [
          "**/*",
          "!.bin/**/*",
          "!typescript/**/*",
          "!tsx/**/*",
          "!@esbuild/**/*",
          "!esbuild/**/*",
          "!@types/**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "bsdiff-wasm": "0.1.4",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "node-fetch": "3.3.2",
    "semver": "7.8.5",
    "socks-proxy-agent": "8.0.5"
  }
}
