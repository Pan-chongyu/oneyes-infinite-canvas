{
  "name": "@basketikun/canvas-proxy",
  "version": "0.2.0",
  "private": true,
  "description": "Minimal local forwarding proxy that lets the Infinite Canvas web app call AI provider APIs without CORS restrictions.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "canvas-proxy": "index.js"
  },
  "files": [
    "index.js",
    "transport.js",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "node-fetch": "3.3.2",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "socks-proxy-agent": "8.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
